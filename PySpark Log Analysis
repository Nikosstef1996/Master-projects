   "source": [
    "from pyspark import SparkContext\n",
    "import re"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 5,
   "metadata": {
    "id": "3A_gYkZusgoN"
   },
   "outputs": [],
   "source": [
    "# SparkContext: The main object that connects your code to Spark’s engine. It lets you load data, create RDDs, and run distributed operations.\n",
    "\n",
    "# \"local\": Tells Spark to run in local mode, using your computer's resources (not a cluster). Great for development and small-scale testing.\n",
    "\n",
    "# \"LogAnalysis\": This is the application name. It helps identify your job in Spark’s UI or logs. You can name it anything relevant.\n",
    "\n",
    "sc = SparkContext(\"local\", \"LogAnalysis\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 6,
   "metadata": {
