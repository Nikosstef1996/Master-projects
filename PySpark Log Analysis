   "source": [
    "# Load log file\n",
    "logs = sc.textFile(\"/content/access_log.txt\")\n",
    "\n",
    "# First 10 lines of our access_log text file\n",
    "print(\"logs:\\n\")\n",
    "for line in logs.take(10):\n",
    "    print(line)"
   ]
