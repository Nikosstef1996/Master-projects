     "text": [
      "access_log:\n",
      "\n",
      "('User107', 'INFO', '/home')\n",
      "('User105', 'INFO', '/home')\n",
      "('User101', 'ERROR', '/dashboard')\n",
      "('User112', 'INFO', '/login')\n",
      "('User118', 'INFO', '/home')\n",
